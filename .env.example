PUBLIC_GALLERY_OWNER_PUBKEY=<hex pubkey of gallery owner>
PUBLIC_BLOSSOM_SERVERS=https://blossom.nostr.build,https://blossom.band
# Encrypted full-res blobs; must accept application/octet-stream
PUBLIC_BLOSSOM_ENCRYPTED_SERVERS=https://nostr.download
PUBLIC_BLOSSOM_MAX_FILE_SIZE_MB=20
PUBLIC_RELAY_URLS=wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol
# Serve only the owner's gallery at / (no other sellers, no Pro tier)
PUBLIC_SINGLE_OWNER_MODE=false
GALLERY_OWNER_NSEC=nsec1...
NWC_URI=nostr+walletconnect://...
